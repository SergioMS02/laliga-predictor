      <!----><app-noticias _ngcontent-c85="" class="c-quiniela-home__main__sidebar__content__banner-fijo ng-star-inserted" _nghost-c92=""><!----><div _ngcontent-c92="" class="c-noticias ng-star-inserted">
    <div _ngcontent-c92="" class="c-noticias__header u-clickable">
        
        <h2 _ngcontent-c92="" class="c-noticias__header__title u-h2">Noticias de la quiniela</h2>
        <span _ngcontent-c92="" class="c-noticias__header__view_more fa fa-minus"></span>
