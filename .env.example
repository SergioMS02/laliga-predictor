# Copia este fichero a .env (en local) o crea Secrets con estos nombres en GitHub.
# Todo es opcional: sin claves el sistema funciona igual (noticias por reglas, sin avisos).

# Avisos por Telegram: habla con @BotFather -> /newbot. Para el chat id, escribe a tu bot
# y abre https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM gratuito para leer noticias (elige uno y ajusta news.llm_backend en config.yaml):
# Gemini (aistudio.google.com -> Get API key, tier gratuito)
GEMINI_API_KEY=
# Endpoint compatible con OpenAI (Groq, OpenRouter...). Para Ollama local no hace falta.
LLM_API_KEY=
