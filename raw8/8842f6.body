        <!-- Fix enlaces iOS: evita doble tap sin provocar doble navegación -->
<script>
(function () {
    'use strict';

    var ua = navigator.userAgent || '';

    var isIOS =
        /iPad|iPhone|iPod/.test(ua) ||
        (
            navigator.platform === 'MacIntel' &&
            navigator.maxTouchPoints > 1
        );

    if (!isIOS || !('ontouchstart' in window)) {
        return;
    }

    /*
     * La app ya gestiona correctamente la navegación.
     */
    try {
        if (window.Capacitor) {
            if (
                typeof window.Capacitor.isNativePlatform === 'function' &&
                window.Capacitor.isNativePlatform()
            ) {
                return;
            }

            if (typeof window.Capacitor.getPlatform === 'function') {
                var platform = window.Capacitor.getPlatform();

                if (platform === 'ios' || platform === 'android') {
                    return;
                }
            }
        }
    } catch (error) {
        // Continúa como navegador web.
    }

    var MAX_DISTANCE = 10;
    var MAX_DURATION = 700;

    var gesture = {
        active: false,
        moved: false,
        startX: 0,
        startY: 0,
        startScrollY: 0,
        startTime: 0,
        anchor: null
    };

    var suppressedHref = '';
    var suppressedUntil = 0;

    function findAnchor(target) {
        if (!target || typeof target.closest !== 'function') {
            return null;
        }

        return target.closest('a[href]');
    }

    function isUIAnchor(anchor) {
        var href = (anchor.getAttribute('href') || '')
            .trim()
            .toLowerCase();

        if (
            !href ||
            href === '#' ||
            href.indexOf('javascript:') === 0
        ) {
            return true;
        }

        if (anchor.getAttribute('role') === 'button') {
            return true;
        }

        if (
            anchor.hasAttribute('download') ||
            anchor.hasAttribute('data-toggle') ||
            anchor.hasAttribute('data-bs-toggle') ||
            anchor.hasAttribute('data-slide') ||
            anchor.classList.contains('no-ios-fix')
        ) {
            return true;
        }

        var target = (anchor.getAttribute('target') || '').toLowerCase();

        if (target && target !== '_self') {
            return true;
        }

        if (
            anchor.closest(
                '.dropdown, ' +
                '.modal, ' +
                '.carousel, ' +
                '.owl-carousel, ' +
                '.swiper, ' +
                '.slick-slider, ' +
                '[data-carousel], ' +
                '.slider'
            )
        ) {
            return true;
        }

        return false;
    }

    function cancelGesture() {
        gesture.active = false;
        gesture.moved = true;
        gesture.anchor = null;
    }

    document.addEventListener('touchstart', function (event) {
        if (!event.touches || event.touches.length !== 1) {
            cancelGesture();
            return;
        }

        var anchor = findAnchor(event.target);

        if (!anchor || isUIAnchor(anchor)) {
            cancelGesture();
            return;
        }

        var touch = event.touches[0];

        gesture.active = true;
        gesture.moved = false;
        gesture.startX = touch.clientX;
        gesture.startY = touch.clientY;
        gesture.startScrollY = window.scrollY;
        gesture.startTime = Date.now();
        gesture.anchor = anchor;
    }, {
        capture: true,
        passive: true
    });

    document.addEventListener('touchmove', function (event) {
        if (
            !gesture.active ||
            !event.touches ||
            event.touches.length !== 1
        ) {
            return;
        }

        var touch = event.touches[0];

        if (
            Math.abs(touch.clientX - gesture.startX) > MAX_DISTANCE ||
            Math.abs(touch.clientY - gesture.startY) > MAX_DISTANCE
        ) {
            gesture.moved = true;
        }
    }, {
        capture: true,
        passive: true
    });

    window.addEventListener('scroll', function () {
        if (
            gesture.active &&
            Math.abs(window.scrollY - gesture.startScrollY) > 4
        ) {
            gesture.moved = true;
        }
    }, {
        passive: true
    });

    document.addEventListener('touchcancel', function () {
        cancelGesture();
    }, {
        capture: true,
        passive: true
    });

    document.addEventListener('touchend', function (event) {
        if (!gesture.active) {
            return;
        }

        var anchor = gesture.anchor;
        var touch = event.changedTouches && event.changedTouches[0];
        var duration = Date.now() - gesture.startTime;

        var moved = gesture.moved;

        if (touch) {
            moved =
                moved ||
                Math.abs(touch.clientX - gesture.startX) > MAX_DISTANCE ||
                Math.abs(touch.clientY - gesture.startY) > MAX_DISTANCE;
        }

        if (
            Math.abs(window.scrollY - gesture.startScrollY) > 4
        ) {
            moved = true;
        }

        gesture.active = false;
        gesture.anchor = null;

        if (
            moved ||
            !touch ||
            !anchor ||
            duration > MAX_DURATION ||
            !document.documentElement.contains(anchor)
        ) {
            return;
        }

        var destination;

        try {
            destination = new URL(anchor.href, window.location.href);
        } catch (error) {
            return;
        }

        /*
         * Los protocolos especiales conservan su funcionamiento normal.
         */
        if (
            destination.protocol !== 'http:' &&
            destination.protocol !== 'https:'
        ) {
            return;
        }

        suppressedHref = destination.href;
        suppressedUntil = Date.now() + 800;

        if (destination.href === window.location.href) {
            event.preventDefault();

            if (anchor.hasAttribute('data-reload-current')) {
                window.location.reload();
            }

            return;
        }

        event.preventDefault();
        window.location.assign(destination.href);
    }, {
        capture: true,
        passive: false
    });

    /*
     * Evita el segundo clic generado por iOS después de touchend.
     */
    document.addEventListener('click', function (event) {
        if (Date.now() > suppressedUntil) {
            return;
        }

        var anchor = findAnchor(event.target);

        if (!anchor || anchor.href !== suppressedHref) {
            return;
        }

        event.preventDefault();
        event.stopImmediatePropagation();
    }, {
        capture: true,
        passive: false
    });
})();
</script>
