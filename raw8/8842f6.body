<script>
/* Ajustes de estados del panel de partidos.
 * Se aplica también después de cada recarga AJAX del contenido. */
(function () {
    'use strict';

    if (window.__cmCalPanelStatusEnhancer) return;
    window.__cmCalPanelStatusEnhancer = true;

    function normalizarTexto(valor) {
        return String(valor || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .trim();
    }

    function atributosTexto(elemento) {
        if (!elemento || !elemento.attributes) return '';
        var valores = [];
        for (var i = 0; i < elemento.attributes.length; i++) {
            valores.push(elemento.attributes[i].name + ' ' + elemento.attributes[i].value);
        }
        return normalizarTexto(valores.join(' '));
    }

    function esDescanso(partido, estado) {
        var textoEstado = normalizarTexto(estado ? estado.textContent : '');
        var textoPartido = normalizarTexto(partido ? partido.textContent : '');
        var atributos = atributosTexto(partido) + ' ' + atributosTexto(estado);
        var combinado = textoEstado + ' ' + textoPartido + ' ' + atributos;

        return /(^|\b)(descanso|entretiempo|medio tiempo|half[ -]?time|halftime)(\b|$)/.test(combinado)
            || /(^|\s)ht($|\s)/.test(combinado);
    }

    function ajustarPartido(partido) {
        if (!partido) return;

        /* Texto completo y explícito cuando ya hay alineaciones oficiales. */
        var onces = partido.querySelector('.cm-cal-match__state--lineups');
        if (onces && normalizarTexto(onces.textContent) !== 'onces confirmados') {
            onces.textContent = 'ONCES CONFIRMADOS';
            onces.setAttribute('aria-label', 'Onces confirmados');
            onces.setAttribute('title', 'Onces confirmados');
        }

        /* El descanso no debe heredar el parpadeo de un partido en juego. */
        var estadoLive = partido.querySelector('.cm-cal-match__state--live');
        var descanso = !!estadoLive && esDescanso(partido, estadoLive);
        partido.classList.toggle('is-halftime', descanso);

        if (descanso) {
            estadoLive.setAttribute('aria-label', 'Descanso');
            estadoLive.setAttribute('title', 'Descanso');
        }
    }

    function ajustarPanel() {
        var contenido = document.getElementById('cal-panel-content');
        if (!contenido) return;
        var partidos = contenido.querySelectorAll('.cm-cal-match');
        for (var i = 0; i < partidos.length; i++) {
            ajustarPartido(partidos[i]);
        }
    }

    function iniciar() {
        var contenido = document.getElementById('cal-panel-content');
        if (!contenido) return;

        ajustarPanel();

        var observer = new MutationObserver(function () {
            ajustarPanel();
        });
        observer.observe(contenido, { childList: true, subtree: true, characterData: true });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciar, { once: true });
    } else {
        iniciar();
    }
})();
</script>

